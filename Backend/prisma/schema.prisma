generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  customer
}

enum OrderStatus {
  pending
  delivered
  completed
  cancelled

  @@map("order_status")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(100)
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@map("users")
}

model Category {
  id           Int       @id @default(autoincrement())
  categoryName String    @map("category_name") @db.VarChar(255)
  products     Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  productName String      @map("product_name") @db.VarChar(255)
  salesPrice  Int         @map("sales_price")
  mrp         Int
  images      String[]    @default([])
  categoryId  Int         @map("category_id")
  stock       Int         @default(0)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  carts      Cart[]
  orderItems OrderItem[]

  /// @bolt-performance: Adding index on categoryId to prevent full table scans when filtering products by category
  @@index([categoryId])
  @@map("products")
}

model Cart {
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@unique([userId, productId])
  @@map("carts")
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  fullName    String   @map("full_name") @db.VarChar(100)
  phone       String   @db.VarChar(15)
  pincode     String   @db.VarChar(6)
  houseNumber String   @map("house_number") @db.VarChar(100)
  area        String   @db.VarChar(255)
  landmark    String?  @db.VarChar(255)
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  addressType String   @default("Home") @map("address_type") @db.VarChar(20)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  /// @bolt-performance: Adding index on userId to speed up address lookups for a user
  @@index([userId])
  @@map("addresses")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  addressId   Int?        @map("address_id")
  status      OrderStatus @default(pending)
  totalAmount Decimal?    @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  /// @bolt-performance: Adding indexes on userId and addressId to optimize relation queries
  @@index([userId])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int
  price     Decimal? @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// @bolt-performance: Adding indexes on foreign keys to optimize joins and relation loads
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
